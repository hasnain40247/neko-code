{
  "$schema": "https://neko.ai/theme.json",
  "defs": {
    "bg1": "#F5F1E8",
    "bg2": "#EEE7D5",
    "bg3": "#E5DCC5",
    "bg4": "#DBCFB0",
    "bg5": "#C8B896",
    "bg6": "#B8A47C",
    "bg7": "#8B7355",
    "bg8": "#6B5D45",
    "primary": "#8B7355",
    "primaryBright": "#A0845E",
    "secondary": "#6B8E23",
    "accent": "#B8860B",
    "text": "#1A1A1A",
    "textMuted": "#6B5D45",
    "red": "#A0342C",
    "orange": "#B87333",
    "green": "#556B2F",
    "cyan": "#4A7C7E",
    "yellow": "#B8860B"
  },
  "theme": {
    "primary": { "dark": "primary", "light": "primary" },
    "secondary": { "dark": "secondary", "light": "secondary" },
    "accent": { "dark": "accent", "light": "accent" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "orange", "light": "orange" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "cyan", "light": "cyan" },
    "text": { "dark": "text", "light": "text" },
    "textMuted": { "dark": "textMuted", "light": "textMuted" },
    "background": { "dark": "bg1", "light": "bg1" },
    "backgroundPanel": { "dark": "bg2", "light": "bg2" },
    "backgroundElement": { "dark": "bg2", "light": "bg2" },
    "backgroundMenu": { "dark": "bg3", "light": "bg3" },
    "border": { "dark": "bg5", "light": "bg5" },
    "borderActive": { "dark": "bg7", "light": "bg7" },
    "borderSubtle": { "dark": "bg4", "light": "bg4" },
    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "textMuted", "light": "textMuted" },
    "diffHunkHeader": { "dark": "primary", "light": "primary" },
    "diffHighlightAdded": { "dark": "#6B8E23", "light": "#6B8E23" },
    "diffHighlightRemoved": { "dark": "#A0342C", "light": "#A0342C" },
    "diffAddedBg": { "dark": "transparent", "light": "transparent" },
    "diffRemovedBg": { "dark": "transparent", "light": "transparent" },
    "diffContextBg": { "dark": "transparent", "light": "transparent" },
    "diffLineNumber": { "dark": "bg6", "light": "bg6" },
    "diffAddedLineNumberBg": { "dark": "transparent", "light": "transparent" },
    "diffRemovedLineNumberBg": { "dark": "transparent", "light": "transparent" },
    "markdownText": { "dark": "text", "light": "text" },
    "markdownHeading": { "dark": "primary", "light": "primary" },
    "markdownLink": { "dark": "secondary", "light": "secondary" },
    "markdownLinkText": { "dark": "cyan", "light": "cyan" },
    "markdownCode": { "dark": "bg7", "light": "bg7" },
    "markdownBlockQuote": { "dark": "textMuted", "light": "textMuted" },
    "markdownEmph": { "dark": "accent", "light": "accent" },
    "markdownStrong": { "dark": "primary", "light": "primary" },
    "markdownHorizontalRule": { "dark": "bg6", "light": "bg6" },
    "markdownListItem": { "dark": "primary", "light": "primary" },
    "markdownListEnumeration": { "dark": "secondary", "light": "secondary" },
    "markdownImage": { "dark": "secondary", "light": "secondary" },
    "markdownImageText": { "dark": "cyan", "light": "cyan" },
    "markdownCodeBlock": { "dark": "text", "light": "text" },
    "syntaxComment": { "dark": "textMuted", "light": "textMuted" },
    "syntaxKeyword": { "dark": "primary", "light": "primary" },
    "syntaxFunction": { "dark": "accent", "light": "accent" },
    "syntaxVariable": { "dark": "bg7", "light": "bg7" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "orange", "light": "orange" },
    "syntaxType": { "dark": "cyan", "light": "cyan" },
    "syntaxOperator": { "dark": "secondary", "light": "secondary" },
    "syntaxPunctuation": { "dark": "text", "light": "text" }
  }
}
